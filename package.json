{
  "name": "realtime-channels",
  "version": "0.3.0",
  "description": "Tiny realtime channel client with pluggable transports: one API for subscribing, publishing and reconnecting. Ships a zero-dependency AWS AppSync Events adapter and an ASP.NET Core SignalR adapter built on the official @microsoft/signalr client; runs in browsers, React Native (including Expo Go) and Node.",
  "license": "MIT",
  "author": "Nikos Pnevmatikos",
  "repository": {
    "type": "git",
    "url": "https://github.com/NikPnevmatikos/realtime-channels.git"
  },
  "homepage": "https://github.com/NikPnevmatikos/realtime-channels#readme",
  "bugs": "https://github.com/NikPnevmatikos/realtime-channels/issues",
  "keywords": [
    "realtime",
    "websocket",
    "pubsub",
    "channels",
    "appsync",
    "appsync-events",
    "signalr",
    "aspnetcore",
    "azure-signalr",
    "aws",
    "react",
    "react-native",
    "expo"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./appsync-events": {
      "import": {
        "types": "./dist/appsync-events.d.ts",
        "default": "./dist/appsync-events.js"
      },
      "require": {
        "types": "./dist/appsync-events.d.cts",
        "default": "./dist/appsync-events.cjs"
      }
    },
    "./signalr": {
      "import": {
        "types": "./dist/signalr.d.ts",
        "default": "./dist/signalr.js"
      },
      "require": {
        "types": "./dist/signalr.d.cts",
        "default": "./dist/signalr.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "@microsoft/signalr": ">=8.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@microsoft/signalr": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
